# Satır sonlarını sabitle: repoda ve çalışma kopyasında LF.
# Servisler Linux container'larda koştuğu için CRLF sızması kırılmaya yol açar.
* text=auto eol=lf

# CRLF ile bozulan dosyalar (açıkça işaretli)
*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
Dockerfile text eol=lf
Makefile text eol=lf

# Windows'a özgü betikler
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# İkili dosyalar — dönüştürme yapılmaz
*.pkl binary
*.joblib binary
*.npy binary
*.zip binary
*.7z binary
*.png binary
*.jpg binary
