# Bu dosyayı .env olarak kopyala ve doldur. .env ASLA git'e commit edilmez.

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RAW=sensor.vibration.raw
KAFKA_TOPIC_FEATURES=sensor.vibration.features
KAFKA_TOPIC_ANOMALY=anomaly.detected
KAFKA_TOPIC_DLQ=anomaly.dlq

# --- TimescaleDB ---
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=sentinel
TIMESCALE_DSN=postgresql://sentinel:CHANGE_ME@localhost:5432/sentinel

# --- Redis (Celery broker) ---
REDIS_URL=redis://localhost:6379/0

# --- Telegram ---
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_CHAT_ID=CHANGE_ME

# --- Simülatör ---
PLAYBACK_INTERVAL_SEC=1.0      # snapshot'lar arası bekleme (sn); IMS nominali 10 dk
# IMS_DATA_PATH=./data/ims/2nd_test   # IMS dosyalarının host klasörü (yaprak klasör)

# --- Chunk / Reassembly ---
SIM_TOTAL_CHUNKS=8              # bir snapshot kaç chunk'a bölünecek
REASSEMBLY_MIN_CHUNKS_RATIO=0.5   # kısmi işleme alt eşiği (0.5 = 4/8)
REASSEMBLY_TIMEOUT_FLOOR=0.5   # sn — çok hızlı playback'te taban timeout
REASSEMBLY_TIMEOUT_FACTOR=1.5  # nominal aralığın kaç katı beklensin
MAX_PENDING_SNAPSHOTS=100      # bellekte aynı anda tutulacak yarım snapshot sınırı

# --- Anomali eşikleri ---
ANOMALY_ZSCORE_WARNING=5.0     # Set 2 kalibrasyonu (ADR-0006); 3.0 bearing_2'de erken alarm
ANOMALY_ZSCORE_CRITICAL=8.0
BASELINE_WINDOW=200            # baseline için ilk kaç snapshot sağlıklı sayılsın
MA_WINDOW=5                    # Z-Score hareketli ortalama penceresi (gürültü bastırma)
ALARM_COOLDOWN=60              # aynı alarm için bildirim debounce (sn, playback zamanı)

# --- Loglama ---
LOG_LEVEL=INFO
